{
  "name": "poe2-upgrade-checker-zh-tw",
  "version": "0.4.3",
  "description": "Path of Exile 2 中文版（繁體）悬浮窗：导入 Path of Building 链接即可查看装备、技能与天赋树，并按 PoB 计算判定升级。基于 ets-public/poe2-upgrade-checker 修改。",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/core.test.js test/trade.test.js test/rates.test.js test/listing.test.js test/pob.test.js test/pobverdict.test.js test/price.test.js test/affixes.test.js test/datadir.test.js",
    "pob": "node tools/get-pob.js",
    "dist": "node tools/get-pob.js && npx electron-builder@25.1.8 --win nsis portable --publish never && node tools/clean-app-data.js --yes",
    "dist:linux": "node tools/get-pob.js && npx electron-builder@25.1.8 --linux AppImage --publish never && node tools/clean-app-data.js --yes",
    "clean:data": "node tools/clean-app-data.js --yes",
    "i18n:data": "node tools/fetch-zh-tw-po.js && node tools/make-zh-tw-data.js",
    "affixes:data": "node tools/make-affix-data.js"
  },
  "devDependencies": {
    "electron": "33.4.11"
  },
  "build": {
    "appId": "local.poe2.upgradechecker",
    "productName": "PoE2 Upgrade Checker 中文版（繁體）",
    "files": [
      "src/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis",
        "portable"
      ],
      "extraResources": [
        {
          "from": "vendor/pob",
          "to": "pob",
          "filter": [
            "runtime/*.dll",
            "runtime/pobhost.exe"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "PoE2-Upgrade-Checker-Portable-${version}.exe"
    },
    "extraResources": [
      {
        "from": "vendor/pob",
        "to": "pob",
        "filter": [
          "src/**/*.lua",
          "src/**/*.json",
          "!src/Export/**",
          "runtime/lua/**",
          "LICENSE.md",
          "manifest.xml"
        ]
      },
      {
        "from": "pob/server.lua",
        "to": "pob/server.lua"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "PoE2-Upgrade-Checker-Setup-${version}.exe",
      "shortcutName": "PoE2 Upgrade Checker 中文版（繁體）"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "zhangyh222",
        "repo": "poe2-upgrade-checker-zh-tw",
        "releaseType": "release"
      }
    ],
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "extraResources": [
        {
          "from": "vendor/pob",
          "to": "pob",
          "filter": [
            "runtime/linux/**",
            "!runtime/linux/.version"
          ]
        }
      ],
      "artifactName": "PoE2-Upgrade-Checker.AppImage",
      "synopsis": "Is this item an upgrade for your PoE2 build?"
    }
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "author": {
    "name": "zhangyh222"
  },
  "homepage": "https://github.com/zhangyh222/poe2-upgrade-checker-zh-tw"
}
